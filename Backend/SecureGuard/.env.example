# ──────────────────────────────────────────────────────────────
# SmartGuard – docker-compose konfiguracija
# Kopiraj u `.env` i popuni vrijednosti:  cp .env.example .env
# `.env` se NE commit-uje (vidi .gitignore).
# ──────────────────────────────────────────────────────────────

# Okruženje za .NET servise (Production za Docker; Development otključava Swagger/test endpointe)
ASPNETCORE_ENVIRONMENT=Production

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# SQL Server
SQLSERVER_PORT=1433
SQLSERVER_SA_PASSWORD=ChangeThisStrongPassword!123
SQLSERVER_EDITION=Developer
SQLSERVER_DB=SmartGuardDb

# JWT (mora biti identičan za API i Notifications servis; min. 32 karaktera)
JWT_SECRET=ChangeThisToALongRandomSecretAtLeast32Chars!

# SMTP (Notifications servis) – npr. Mailtrap sandbox
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@smartguard.local
SMTP_FROM_NAME=SmartGuard
