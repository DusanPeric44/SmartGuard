@page
@using SmartGuardLanding.Pages
@model IndexModel
@{
    ViewData["Title"] = "SmartGuard – Open-Source IoT Security System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="https://i.imgur.com/Ppeoq4x.png">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- NAV -->
    <nav class="nav">
        <div class="nav-inner">
            <div class="nav-logo">
                <img src="https://i.imgur.com/Ppeoq4x.png" alt="SmartGuard Logo" class="logo-img" />
                <span class="logo-text">SmartGuard</span>
            </div>
            <div class="nav-links">
                <a href="#features">Features</a>
                <a href="#architecture">Architecture</a>
                <a href="#download">Download</a>
                <a href="https://github.com/DusanPeric44/SmartGuard" target="_blank" class="nav-github">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
                    GitHub
                </a>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <div class="hero-grid"></div>
        <div class="hero-glow"></div>
        <div class="hero-content">
            <div class="hero-badge">
                <span class="badge-dot"></span>
                Open-Source IoT Security
            </div>
            <h1 class="hero-title">
                Your Home.<br />
                <span class="accent">Your Control.</span><br />
                Your Data.
            </h1>
            <p class="hero-sub">
                Self-hosted security system combining ESP32-CAM edge devices,
                .NET real-time backend, and Flutter apps — with zero cloud dependency.
            </p>
            <div class="hero-cta">
                <a href="#download" class="btn btn-primary">Download Now</a>
                <a href="https://github.com/DusanPeric44/SmartGuard" target="_blank" class="btn btn-ghost">View on GitHub</a>
            </div>
            <div class="hero-badges">
                <img src="https://img.shields.io/badge/Licenca-Open%20Source-blue?style=for-the-badge" alt="License" />
                <img src="https://img.shields.io/badge/Platform-.NET%20%7C%20Flutter%20%7C%20ESP32-purple?style=for-the-badge" alt="Platform" />
                <img src="https://img.shields.io/badge/Backend-.NET%2010.0-512BD4?style=for-the-badge&logo=dotnet" alt="Backend" />
                <img src="https://img.shields.io/badge/Mobile-Flutter-0256B9?style=for-the-badge&logo=flutter" alt="Mobile" />
            </div>
        </div>
        <div class="hero-visual">
            <div class="device-mockup">
                <div class="device-screen">
                    <div class="screen-header">
                        <span class="screen-dot red"></span>
                        <span class="screen-dot yellow"></span>
                        <span class="screen-dot green"></span>
                        <span class="screen-title">SmartGuard Live</span>
                    </div>
                    <div class="screen-body">
                        <div class="cam-feed">
                            <div class="cam-label">CAM-01 · LIVE</div>
                            <div class="cam-pulse"></div>
                            <svg class="cam-icon" viewBox="0 0 60 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <rect x="2" y="8" width="40" height="28" rx="4" stroke="#00d4ff" stroke-width="2"/>
                                <circle cx="22" cy="22" r="7" stroke="#00d4ff" stroke-width="2"/>
                                <circle cx="22" cy="22" r="3" fill="#00d4ff" opacity="0.4"/>
                                <path d="M42 16l14-8v24l-14-8V16z" stroke="#00d4ff" stroke-width="2" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="status-grid">
                            <div class="status-item ok">
                                <span class="status-icon">🔒</span>
                                <span>Armed</span>
                            </div>
                            <div class="status-item ok">
                                <span class="status-icon">📡</span>
                                <span>3 Devices</span>
                            </div>
                            <div class="status-item warn">
                                <span class="status-icon">👤</span>
                                <span>Face Detected</span>
                            </div>
                            <div class="status-item ok">
                                <span class="status-icon">🔔</span>
                                <span>Alerts On</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- PILLARS -->
    <section class="pillars">
        <div class="container">
            <div class="pillars-grid">
                <div class="pillar">
                    <div class="pillar-icon">🔒</div>
                    <h3>Privacy First</h3>
                    <p>Your data stays local — no third-party cloud, no subscriptions, no surveillance capitalism.</p>
                </div>
                <div class="pillar">
                    <div class="pillar-icon">💾</div>
                    <h3>Minimal Storage</h3>
                    <p>Event-driven recording with ring buffer. Only relevant footage is saved, not 24/7 video.</p>
                </div>
                <div class="pillar">
                    <div class="pillar-icon">⚡</div>
                    <h3>Real-Time</h3>
                    <p>Live stream + instant push notifications via SignalR. Zero intermediaries.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FEATURES -->
    <section class="features" id="features">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Capabilities</span>
                <h2>Built for real security needs</h2>
                <p>Every feature designed around your privacy and control.</p>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🎥</div>
                    <h4>Zero-Latency Live Stream</h4>
                    <p>ESP32 pushes JPEG frames to the backend, forwarded via SignalR to clients in real time.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📅</div>
                    <h4>Event-Driven Recording</h4>
                    <p>Recordings are created only on motion, face detection, or alarm — never wasteful 24/7 streams.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔁</div>
                    <h4>SD Ring Buffer</h4>
                    <p>Normal footage is cycled on-device via ring buffer; event clips are treated as priority archives.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">👤</div>
                    <h4>Face Recognition</h4>
                    <p>Backend cosine-similarity matching against known persons via 128-float embeddings. No on-device ML.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔔</div>
                    <h4>Selective Notifications</h4>
                    <p>Push and email alerts only for event types and specific people you choose to monitor.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔑</div>
                    <h4>Role-Based Security</h4>
                    <p>JWT auth, Admin/HomeOwner/Viewer roles, full audit trail, and soft delete across all entities.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📈</div>
                    <h4>Multi-Device Scalable</h4>
                    <p>Multiple ESP32 cameras supported with async RabbitMQ message broker processing.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🐳</div>
                    <h4>Docker Ready</h4>
                    <p>Full Docker Compose stack: API, workers, SQL Server, RabbitMQ, Redis — one command deploy.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ARCHITECTURE -->
    <section class="architecture" id="architecture">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Architecture</span>
                <h2>How SmartGuard works</h2>
                <p>Clear separation between edge, real-time, and background processing.</p>
            </div>
            <div class="arch-flow">
                <div class="arch-node edge">
                    <div class="arch-icon">📡</div>
                    <div class="arch-label">ESP32-CAM</div>
                    <div class="arch-sub">Edge · Local Buffer</div>
                </div>
                <div class="arch-arrow">→</div>
                <div class="arch-node api">
                    <div class="arch-icon">🖥️</div>
                    <div class="arch-label">REST API</div>
                    <div class="arch-sub">.NET · SignalR</div>
                </div>
                <div class="arch-arrow">→</div>
                <div class="arch-node broker">
                    <div class="arch-icon">🐇</div>
                    <div class="arch-label">RabbitMQ</div>
                    <div class="arch-sub">Message Broker</div>
                </div>
                <div class="arch-arrow">→</div>
                <div class="arch-node workers">
                    <div class="arch-icon">⚙️</div>
                    <div class="arch-label">Workers</div>
                    <div class="arch-sub">Archive · Notify · Match</div>
                </div>
            </div>
            <div class="arch-clients">
                <div class="arch-client">
                    <span>📱</span> Flutter Mobile
                </div>
                <div class="arch-client">
                    <span>🖱️</span> Flutter Desktop
                </div>
                <div class="arch-client">
                    <span>🗄️</span> SQL Server
                </div>
                <div class="arch-client">
                    <span>🔴</span> Redis Cache
                </div>
            </div>
        </div>
    </section>

    <!-- TECH STACK -->
    <section class="stack">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Tech Stack</span>
                <h2>Modern, open tools</h2>
            </div>
            <div class="stack-grid">
                <div class="stack-item">.NET 10.0</div>
                <div class="stack-item">Flutter</div>
                <div class="stack-item">ESP32-CAM</div>
                <div class="stack-item">SignalR</div>
                <div class="stack-item">RabbitMQ</div>
                <div class="stack-item">SQL Server</div>
                <div class="stack-item">Entity Framework</div>
                <div class="stack-item">Redis</div>
                <div class="stack-item">Docker</div>
                <div class="stack-item">FCM Push</div>
                <div class="stack-item">JWT Auth</div>
                <div class="stack-item">gRPC</div>
            </div>
        </div>
    </section>

    <!-- DOWNLOAD -->
    <section class="download" id="download">
        <div class="container">
            <div class="section-header light">
                <span class="section-tag">Get SmartGuard</span>
                <h2>Download the app</h2>
                <p>Available on Windows, macOS, and Android.</p>
            </div>
            <div class="download-grid">
                <!-- Windows -->
                <div class="download-card">
                    <div class="dl-platform-icon">
                        <svg viewBox="0 0 88 88" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="4" width="38" height="38" rx="3" fill="#00adef"/>
                            <rect x="46" y="4" width="38" height="38" rx="3" fill="#00adef"/>
                            <rect x="4" y="46" width="38" height="38" rx="3" fill="#00adef"/>
                            <rect x="46" y="46" width="38" height="38" rx="3" fill="#00adef"/>
                        </svg>
                    </div>
                    <h3>Windows</h3>
                    <p>Desktop admin panel for full system management, reports, and audit logs.</p>
                    <div class="dl-meta">
                        <span>Flutter Desktop</span>
                        <span>Windows 10+</span>
                    </div>
                    <a href="https://github.com/DusanPeric44/SmartGuard/tree/dev/master/Desktop" target="_blank" class="btn btn-download windows">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download for Windows
                    </a>
                </div>

                <!-- macOS -->
                <div class="download-card">
                    <div class="dl-platform-icon">
                        <svg viewBox="0 0 788.1 1000" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z" fill="#a2aaad" />
                        </svg>
                    </div>
                    <h3>macOS</h3>
                    <p>Native macOS desktop client with full administrative controls and live feed viewing.</p>
                    <div class="dl-meta">
                        <span>Flutter Desktop</span>
                        <span>macOS 12+</span>
                    </div>
                    <a href="https://github.com/DusanPeric44/SmartGuard/tree/dev/master/Desktop" target="_blank" class="btn btn-download mac">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download for macOS
                    </a>
                </div>

                <!-- Android -->
                <div class="download-card featured">
                    <div class="featured-badge">Most Popular</div>
                    <div class="dl-platform-icon">
                        <svg viewBox="0 0 88 88" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M14 60V28a4 4 0 0 1 4-4h52a4 4 0 0 1 4 4v32a4 4 0 0 1-4 4H18a4 4 0 0 1-4-4z" fill="#3ddc84"/>
                            <path d="M28 24V16M60 24V16" stroke="#3ddc84" stroke-width="4" stroke-linecap="round"/>
                            <circle cx="36" cy="44" r="4" fill="white"/>
                            <circle cx="52" cy="44" r="4" fill="white"/>
                            <path d="M36 56h16" stroke="white" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <h3>Android</h3>
                    <p>Full-featured mobile app: live monitoring, event history, push alerts, and known persons management.</p>
                    <div class="dl-meta">
                        <span>Flutter Mobile</span>
                        <span>Android 8.0+</span>
                    </div>
                    <a href="https://github.com/DusanPeric44/SmartGuard/tree/dev/master/Mobile" target="_blank" class="btn btn-download android">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Download for Android
                    </a>
                </div>
            </div>

            <div class="download-note">
                <p>
                    SmartGuard is open-source. You can also build from source by cloning the repository and following the setup guide.
                    <a href="https://github.com/DusanPeric44/SmartGuard" target="_blank">View setup instructions →</a>
                </p>
            </div>
        </div>
    </section>

    <!-- TEAM -->
    <section class="team">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">Team</span>
                <h2>Built by</h2>
            </div>
            <div class="team-grid">
                <div class="team-card">
                    <div class="team-avatar">DP</div>
                    <h4>Dušan Perić</h4>
                    <span class="team-id">IB230222</span>
                </div>
                <div class="team-card">
                    <div class="team-avatar">MM</div>
                    <h4>Marko Milidragović</h4>
                    <span class="team-id">IB230221</span>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <img src="https://i.imgur.com/N9LNlam.png" alt="SmartGuard" class="footer-logo" />
                    <span>SmartGuard</span>
                </div>
                <p class="footer-tagline">Your house. Your control. Your data.</p>
                <div class="footer-links">
                    <a href="https://github.com/DusanPeric44/SmartGuard" target="_blank">GitHub</a>
                    <a href="https://github.com/DusanPeric44/SmartGuard/blob/dev/master/Docs/LICENSE" target="_blank">License</a>
                    <a href="https://github.com/DusanPeric44/SmartGuard/tree/dev/master/Backend" target="_blank">Backend Docs</a>
                    <a href="https://github.com/DusanPeric44/SmartGuard/tree/dev/master/Mobile" target="_blank">Mobile Docs</a>
                </div>
                <p class="footer-copy">© 2025 SmartGuard. Open-Source under MIT License.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
