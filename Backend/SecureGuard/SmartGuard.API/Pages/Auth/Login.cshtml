@page "/auth/login"
@model SmartGuard.API.Pages.Auth.LoginModel

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SmartGuard Login</title>
</head>
<body>
    <main style="max-width: 420px; margin: 64px auto; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;">
        <h1 style="margin: 0 0 16px;">Sign in</h1>
        <a href="/auth/google/start"
           style="display: inline-block; padding: 12px 16px; border: 1px solid #111; border-radius: 10px; text-decoration: none; color: #111;">
            Continue with Google
        </a>
    </main>
</body>
</html>

